# Integrated Accelerometer Readers for Testing Purposes in SI-unit form
# This is topic is an integration of the vehicle_imu topic data

uint64 timestamp	# time since system start (microseconds)
float32 vx		# velocity (m/s) x component based on vehicle_imu axis
float32 vy		# velocity (m/s) y component based on vehicle_imu axis
float32 vz		# velocity (m/s) z component based on vehicle_imu axis
